      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\nconst nichos = [...new Set(rows.map(r => (r.Nicho || '').trim()).filter(Boolean))];\nconst ciudades = [...new Set(rows.map(r => (r.Ciudad || '').trim()).filter(Boolean))];\n\nif (nichos.length === 0 || ciudades.length === 0) {\n  throw new Error('La pestaña Config debe tener al menos un valor en la columna Nicho y en la columna Ciudad');\n}\n\nconst niche = nichos[Math.floor(Math.random() * nichos.length)];\nconst city = ciudades[Math.floor(Math.random() * ciudades.length)];\n\nreturn [{\n  json: {\n    niche,\n    city,\n    original: `Búscame ${niche} en ${city}.`\n  }\n}];"
